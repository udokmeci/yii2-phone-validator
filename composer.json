{
    "name": "udokmeci/yii2-phone-validator",
    "type": "yii2-extension",
    "description": "Modern Yii2 Phone validator wrapper on top of PhoneNumberUtil library also used by Android devices",
    "keywords": ["phone number","phone number validator","yii2"],
    "homepage": "https://github.com/udokmeci/yii2-phone-validator",
    "license": "MIT",
    "authors": [
        {
            "name": "Uğur DÖKMECİ",
            "email": "ugurdokmeci@gmail.com",
            "homepage": "https://github.com/udokmeci/yii2-phone-validator",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "ugurdokmeci@gmail.com",
        "source": "https://github.com/udokmeci/yii2-phone-validator"
    },
    "require": {
        "php": ">=8.1.0",
        "yiisoft/yii2": "^2.0.40",
        "giggsey/libphonenumber-for-php": "^8.13"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4" : {
            "udokmeci\\yii2PhoneValidator\\" : "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/",
        "analyse": "phpstan analyse src/"
    },
    "extra": {
        "bootstrap": "udokmeci\\yii2PhoneValidator\\Bootstrap",
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
